#!/usr/bin/env bash
set -euo pipefail

# Block direct commits on protected default branches
branch="$(git branch --show-current 2>/dev/null || true)"
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "ERROR: Direct commits on '$branch' are not allowed."
  echo "Create a feature branch first. See .github/skills/feature-branch-workflow.md"
  exit 1
fi

markdown_files=()
while IFS= read -r file; do
  markdown_files+=("$file")
done < <(
  git diff --cached --name-only --diff-filter=ACMR |
    grep -E '\.md$' |
    grep -Ev '^(node_modules|vendor|\.bundle|tmp|coverage|specifications)/'
)

if [ "${#markdown_files[@]}" -eq 0 ]; then
  exit 0
fi

echo "Running markdownlint on Markdown files..."
npx --yes markdownlint-cli2 "${markdown_files[@]}" 2>&1
