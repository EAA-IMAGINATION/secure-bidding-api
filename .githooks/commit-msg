#!/bin/sh
# Final gate before commit completes — strip again, then fail if Copilot/Cursor trailers remain.

. "$(dirname "$0")/strip-ai-trailers.sh"
strip_ai_trailers "$1"

if has_ai_trailers "$1"; then
  echo "ERROR: Commit message must not include Copilot or Cursor co-author trailers (course rule)."
  exit 1
fi
